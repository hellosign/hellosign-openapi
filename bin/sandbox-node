#!/usr/bin/env bash

set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)

WORKING_DIR="/app/openapi"
SDK_DIR="${DIR}/../sdks/node"
TARGET_DIR="${DIR}/../sandbox/node"
ARTIFACTS_DIR="${DIR}/../sandbox/node/artifacts"

mkdir -p "${ARTIFACTS_DIR}" "${SDK_DIR}/.docker/npm" "${SDK_DIR}/.docker/home"
rm -f "${ARTIFACTS_DIR}/*.tgz"
rm -f "${TARGET_DIR}/src/*.ts"
rm -f "${TARGET_DIR}/src/*.js"
rm -f "${TARGET_DIR}/package-lock.json"
rm -rf "${TARGET_DIR}/node_modules"

node_run() {
  "${DIR}/docker-run" -it \
    -v "${SDK_DIR}:${WORKING_DIR}" \
    -v "${ARTIFACTS_DIR}:/artifacts" \
    -v "${SDK_DIR}/.docker/npm:/tmp/npm-cache" \
    -v "${SDK_DIR}/.docker/home:/tmp/home" \
    -e HOME=/tmp/home \
    -e npm_config_cache=/tmp/npm-cache \
    -w "${WORKING_DIR}" \
    node:22 "$@"
}

node_run npm install
node_run npm run build
node_run npm pack --pack-destination /artifacts

mv "${ARTIFACTS_DIR}/"*.tgz "${ARTIFACTS_DIR}/dropbox-sign-sdk.tgz"
