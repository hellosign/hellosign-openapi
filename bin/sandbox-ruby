#!/usr/bin/env bash

set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)

WORKING_DIR="/app/openapi"
SDK_DIR="${DIR}/../sdks/ruby"
TARGET_DIR="${DIR}/../sandbox/ruby"
ARTIFACTS_DIR="${DIR}/../sandbox/ruby/artifacts"

rm -rf "${ARTIFACTS_DIR}"
mkdir -p "${ARTIFACTS_DIR}/gems" "${SDK_DIR}/.docker/gem" "${SDK_DIR}/.docker/bundle"

"${DIR}/docker-run" \
  -e GEM_HOME=/tmp/gem \
  -e BUNDLE_PATH=/tmp/bundle \
  -e HOME=/tmp/gem \
  -v "${SDK_DIR}:${WORKING_DIR}" \
  -v "${ARTIFACTS_DIR}:/artifacts" \
  -v "${SDK_DIR}/.docker/gem:/tmp/gem" \
  -v "${SDK_DIR}/.docker/bundle:/tmp/bundle" \
  -w "${WORKING_DIR}" \
  ruby:3.4 gem build dropbox-sign.gemspec -o /artifacts/gems/dropbox-sign.gem

"${DIR}/docker-run" \
  -e GEM_HOME=/tmp/gem \
  -e BUNDLE_PATH=/tmp/bundle \
  -e HOME=/tmp/gem \
  -v "${ARTIFACTS_DIR}:/artifacts" \
  -v "${SDK_DIR}/.docker/gem:/tmp/gem" \
  -v "${SDK_DIR}/.docker/bundle:/tmp/bundle" \
  -w "/artifacts" \
  ruby:3.4 gem generate_index
