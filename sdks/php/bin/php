#!/usr/bin/env bash

set -e

DIR=$(cd `dirname $0` && pwd)
ROOT_DIR="${DIR}/.."
WORKING_DIR="/app/php"

if [[ "$PHP_USE_NATIVE" -ne 1 ]]; then
  mapfile -t DOCKER_USER_ARGS < <("${DIR}/../../../bin/docker-user-args")
  mkdir -p "${ROOT_DIR}/.composer"

  docker run --rm \
    --platform linux/amd64 \
    "${DOCKER_USER_ARGS[@]}" \
    -v "${ROOT_DIR}:${WORKING_DIR}" \
    -v "${ROOT_DIR}/.composer:/tmp/composer" \
    -e COMPOSER_HOME=/tmp/composer \
    -w "${WORKING_DIR}" \
    jtreminio/php-cli:7.4 "$@"

    exit 0
fi

pushd "${ROOT_DIR}"
exec "$@"
popd
