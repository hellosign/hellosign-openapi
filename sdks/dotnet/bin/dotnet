#!/usr/bin/env bash

set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)
ROOT_DIR="${DIR}/.."
WORKING_DIR="/app/dotnet"

mkdir -p "${ROOT_DIR}/.docker/nuget" "${ROOT_DIR}/.docker/home"

exec "${DIR}/../../../bin/docker-run" \
  -v "${ROOT_DIR}:${WORKING_DIR}" \
  -v "${ROOT_DIR}/.docker/home:/tmp/home" \
  -v "${ROOT_DIR}/.docker/nuget:/tmp/nuget" \
  -e HOME=/tmp/home \
  -e NUGET_PACKAGES=/tmp/nuget \
  -w "${WORKING_DIR}" \
  mcr.microsoft.com/dotnet/sdk:8.0 "$@"
