#!/usr/bin/env bash

set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)
ROOT_DIR="${DIR}/.."

mkdir -p "${ROOT_DIR}/.docker/npm" "${ROOT_DIR}/.docker/home" "${ROOT_DIR}/node_modules"

exec "${DIR}/../../../bin/docker-run" \
  -v "${ROOT_DIR}:/app" \
  -v "${ROOT_DIR}/node_modules:/app/node_modules" \
  -v "${ROOT_DIR}/.docker/npm:/tmp/npm-cache" \
  -v "${ROOT_DIR}/.docker/home:/tmp/home" \
  -e HOME=/tmp/home \
  -e npm_config_cache=/tmp/npm-cache \
  -w /app \
  node:18 "$@"
