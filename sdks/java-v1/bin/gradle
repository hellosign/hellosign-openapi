#!/usr/bin/env bash

# You probably want to run ./bin/gradle ./gradlew clean build

set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)
ROOT_DIR="${DIR}/.."
WORKING_DIR="/app/java"

mkdir -p "${ROOT_DIR}/.docker/gradle"

exec "${DIR}/../../../bin/docker-run" \
  -v "${ROOT_DIR}:${WORKING_DIR}" \
  -v "${ROOT_DIR}/.docker/gradle:/tmp/gradle-user-home" \
  -e GRADLE_USER_HOME=/tmp/gradle-user-home \
  -e HOME=/tmp/gradle-user-home \
  -e GEN_DIR=/app \
  -w "${WORKING_DIR}" \
  gradle:7.6.1-jdk11 "$@"
